FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 -0.5);

boundaryField
{
    tank_inlet
    {
        type            fixedValue;
        value           uniform (0 0 -0.5);
    }
    tank_outlet
    {
        type            zeroGradient;
    }
    tank_walls
    {
        type            noSlip;
    }
}
