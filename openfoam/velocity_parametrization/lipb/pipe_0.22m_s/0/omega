dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 2.7329719724997434;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 2.7329719724997434;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            omegaWallFunction;
        value           uniform 2.7329719724997434;
    }
}


